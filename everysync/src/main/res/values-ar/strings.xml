    <string name="snapshot_restore_confirm">إعادة تشغيل <xliff:g id="date" example="Oct 13, 2026">%1$s</xliff:g> (<xliff:g id="type" example="passwords">%2$s</xliff:g>) من خلال المزامنة؟ لا تزال التعديلات الأحدث هي السائدة في حالة التعارض.</string>
