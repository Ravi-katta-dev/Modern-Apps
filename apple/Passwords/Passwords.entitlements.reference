<!-- EverySync Passwords — entitlements reference (Phase 3, Mac fills values).
     App-Group envelope IPC + shared Keychain group with the Credential
     Provider extension. Replace <team> with the real team prefix. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.&lt;team&gt;.everysync.shared</string>
    </array>
    <!-- Shared with the .autofill extension (see CredentialProvider.swift). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.vayunmathur.everysync.shared</string>
    </array>
</dict>
</plist>
