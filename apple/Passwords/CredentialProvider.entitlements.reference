<!-- EverySync Credential Provider extension — entitlements reference.
     The ONLY target with the autofill-credential-provider entitlement. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.&lt;team&gt;.everysync.shared</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.vayunmathur.everysync.shared</string>
    </array>
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <true/>
</dict>
</plist>
