<resources>
    <string name="app_name">MA Cast</string>

    <!-- Idle screen -->
    <string name="tv_ready_title">Ready to receive</string>
    <string name="tv_ready_hint">Open Cast on your phone and pick %1$s.</string>
    <string name="tv_name_unknown">this TV</string>
    <string name="tv_starting">Starting.</string>

    <!-- The receiver could not advertise itself. Distinct from "nothing has connected yet",
         because nothing about the phone or the network will fix it. -->
    <string name="tv_local_network_blocked">Local network access is off</string>
    <string name="tv_local_network_blocked_hint">Android blocks announcing this TV on your network until the app is allowed to. Grant local network access in Settings and reopen MA Cast.</string>

    <!-- Pairing -->
    <string name="tv_pair_title">Enter this code on your phone</string>
    <string name="tv_pair_from">%1$s is asking to connect.</string>
    <plurals name="tv_pair_attempts">
        <item quantity="one">%1$d attempt left</item>
        <item quantity="other">%1$d attempts left</item>
    </plurals>
    <string name="tv_pair_new_code">That code was wrong three times, so here is a new one.</string>
    <string name="tv_paired">Connected to %1$s</string>

    <!-- Mirroring -->
    <string name="tv_mirroring">Receiving from %1$s</string>
    <string name="tv_no_decoder">This TV has no usable H.265 or AV1 decoder</string>
    <string name="tv_no_audio_decoder">This TV has no Opus audio decoder, so it cannot play music from your phone</string>
    <string name="tv_missing_codec_config">Your phone did not send the video settings this TV needed. Try mirroring again.</string>
    <string name="tv_stream_failed">The stream stopped</string>
    <!-- Transport overlay, driven from the TV remote -->
    <string name="tv_transport_speed">%1$s×</string>
    <string name="tv_transport_hint">OK to play or pause · ◀ ▶ to seek · ▲ ▼ for volume</string>

    <!-- Now playing, for an audio-only session where there is no picture -->
    <string name="tv_now_playing_no_artwork">No cover art</string>
    <string name="tv_now_playing_artwork">Cover art</string>
    <string name="tv_now_playing_paused">Paused</string>
    <string name="tv_now_playing_buffering">Buffering…</string>

    <!-- Foreground service -->
    <string name="tv_notification_channel_name">Receiving</string>
    <string name="tv_notification_channel_desc">Shown while this TV is available to cast to</string>
    <string name="tv_notification_text_pairing">Waiting for a pair code</string>

    <!-- Incoming connection: the high-importance channel whose full-screen intent opens the TV
         on its own when a phone connects while the app is in the background. Silent: appearing
         on screen is the alert. -->
    <string name="tv_incoming_channel_name">Incoming cast</string>
    <string name="tv_incoming_channel_desc">Used to open the TV automatically when a phone starts casting</string>

    <!-- Auto-open prompt on the idle screen, until full-screen-intent access is granted. -->
    <string name="tv_auto_open_hint">This TV can open itself when a phone starts casting. Allow it in Settings to turn that on.</string>
    <string name="tv_auto_open_grant">Allow auto-open</string>

    <!-- Ready screen: the three how-to steps. Step 2 names this TV. -->
    <string name="tv_howto_step1_title">Open Cast on your phone</string>
    <string name="tv_howto_step1_body">Join the same Wi-Fi network as this TV.</string>
    <string name="tv_howto_step2_title">Pick %1$s</string>
    <string name="tv_howto_step2_body">Choose this TV from the device list.</string>
    <string name="tv_howto_step3_title">Enter the code shown here</string>
    <string name="tv_howto_step3_body">Type the six digits into your phone to connect.</string>
    <!-- Ready screen footer: privacy facts, plus the network the receiver could read. -->
    <string name="tv_privacy_facts">Encrypted end-to-end · Stays on your Wi-Fi · No account</string>
    <string name="tv_network_line">On %1$s</string>

    <!-- The receiver could not advertise itself: open the app Settings page to grant access. -->
    <string name="tv_local_network_open_settings">Open Settings</string>
</resources>
