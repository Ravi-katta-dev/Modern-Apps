<?xml version="1.0" encoding="utf-8"?>
<!--
  Kart. Audited state: filesDir/datastore/settings.preferences_pb, holding the
  current cup, the lifetime won counter and the best lap. No
  SharedPreferences, no Room database, nothing written to external storage.
  Back everything up; it is a few KB of pure user progress.
  SCOPE: kart declares android:backupAgent=".platform.AppBackupAgent" and does
  NOT set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's datastoreNames = ["settings"], which is
  the same data this file would have sent. <device-transfer> IS governed here,
  and these rules become the cloud control too if the backupAgent is ever
  removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
