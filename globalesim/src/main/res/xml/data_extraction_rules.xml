<?xml version="1.0" encoding="utf-8"?>
<!--
  Global eSIM. Audited state: the anonymous account id, written through
  DataStore into file/datastore/esim_account.preferences_pb. Everything else
  (rates cache, eSIM list) is refetched from api.maproj.org on launch.
  The rules include whole domains rather than that one file so that if further
  persistence is added later it is covered by default instead of being silently
  dropped.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
